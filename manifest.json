{
    "name": "万能的插件",
    "version": "0.1.0",
    "manifest_version": 3,
    "description": "",
    "action": {
      "default_icon": "/images/icon.png",
      "default_popup": "/dist/popup.html",
      "default_title": ""
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["/dist/content.js"],
        "run_at": "document_start",
        "all_frames": true
      }
    ],
    "icons": {
      "16": "/images/icon.png",
      "48": "/images/icon.png",
      "128": "/images/icon.png"
    },
    "minimum_chrome_version": "88",
    "background": {
      "service_worker": "/dist/background.js"
    },
    "options_ui": {
      "page": "/dist/options.html",
      "open_in_tab": false
    },
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "permissions": [
      "contextMenus",
      "bookmarks",
      "storage",
      "desktopCapture",
      "tabs",
      "tabCapture",
      "debugger"
    ],
    "host_permissions": [
      "file:///*",
      "<all_urls>",
      "*://*/",
      "*://*/*"
    ],
    "web_accessible_resources": [{
      "resources": [],
      "matches": ["<all_urls>"]
    }]
  }
  